--dir=.
bin/hallmark
# An explicit file input breaks Watchman in LSP mode, so the LSP won't see
# files changed outside the editor until they're opened.
--disable-watchman
# Sorbet's LSP accepts only one --dir, so check the whole repo and ignore
# everything outside lib/, rbi/ and sorbet/rbi/.
--ignore=/test/
--ignore=/examples/
--ignore=/sorbet/tapioca/
# prism ships an RBI that this Sorbet version rejects; srb loads it from the bundle.
--ignore=/prism.rbi
