#!/usr/bin/env ruby
# typed: true
# frozen_string_literal: true

require "optparse"
require_relative "../lib/hallmark"

USAGE = <<~TEXT.freeze
  Usage:
    hallmark check [--sarif OUT] [--baseline OUT] FILE...
                              run the analyses declared in FILEs; exit 1 on any counterexample,
                              unchecked entry point, drift, policy-DSL or GraphQL hazard, else 2 on any
                              unknown (or error), else 0. A FILE that only maps (config/hallmark.rb)
                              is checked against the stamps the test suite recorded. --sarif also
                              writes what fails as SARIF 2.1.0 to OUT; --baseline writes what CI
                              knows (stamps, each check's digest and verdict) for `hallmark watch`.
    hallmark watch --baseline FILE [options] MAPPING
                              tail the stamps live requests write (HALLMARK_MODE=shadow or sampled),
                              re-check only the exposures they change, and report what the baseline
                              did not have: new counterexamples, unchecked entry points and drift,
                              and checks that no longer fail. Never boots the app.
        --stamps DIR          stamp directory to tail (default HALLMARK_STAMPS, tmp/hallmark)
        --run RUN             the run to tail (default HALLMARK_RUN, else the newest)
        --interval SECONDS    how often to poll the files, or wait on Redis (default 2)
        --redis URL           tail the Redis stream instead (needs the redis-client or redis gem)
        --stream NAME         the stream (default #{Hallmark::Sinks::RedisStream::DEFAULT_STREAM})
        --from-start          read the stream from its first entry, not its end
        --all-runs            keep every run's lines from the stream (else --run is needed)
        --json                one JSON object per event on stdout instead of text
        --sarif FILE          rewrite a SARIF log of everything new after each batch
        --solver cli|sidecar  the backend (default the sidecar, the CLI when it is not built)
        --once                one batch over what is there, then exit 1 on anything new that
                              fails, else 2 on an unknown, else 0; without it, run until
                              SIGINT or SIGTERM
    hallmark model FILE       print the Alloy model generated for FILE
    hallmark extract FILE     print the guard read from each policy rule's code under the app root
                              (FILE's directory, or its parent when FILE is in config/), then each
                              list scope's guard on the records it lists, then each REST serializer's
                              fields and conditions and what each entry point renders
    hallmark rules FILE [POLICY...]
                              check each rule and list scope of the policies (default: every
                              policy read from code) on its own, as the RSpec matchers do, from
                              its code and any recorded stamps; exit 1 on any counterexample or
                              policy-DSL hazard, else 2 on any unknown, else 0
    hallmark install-alloy    download Alloy #{Hallmark::ALLOY_VERSION} and verify its checksum
    hallmark install-sidecar  build the solver sidecar (needs a JDK 17+; installs Alloy first)
    hallmark version

  Environment: HALLMARK_ALLOY_JAR, HALLMARK_JAVA, HALLMARK_SCOPE, HALLMARK_TIMEOUT,
               HALLMARK_SOLVER (cli or sidecar), HALLMARK_SAT_SOLVER (sat4j, minisat, glucose),
               HALLMARK_SIDECAR_JAR, HALLMARK_SIDECAR_HEAP (MB, default 512),
               HALLMARK_STAMPS (default tmp/hallmark), HALLMARK_RUN (the run to read; default the newest),
               HALLMARK_ROOT (the app whose policy code is read),
               HALLMARK_EXTRACT (off: guards from stamps and the mapping only)
TEXT

def load_analyses(files)
  abort USAGE if files.empty?
  files.each do |file|
    use_root(file)
    load_file(file)
  end
  # A mapping with no analyze block: infer the exposures from recorded stamps.
  Hallmark.analyze(File.basename(Dir.pwd)) { stamps } if Hallmark.analyses.empty? && Hallmark.configuration.mapping
  abort "No `Hallmark.analyze` blocks found in #{files.join(", ")}" if Hallmark.analyses.empty?
  Hallmark.analyses
end

# Takes `FLAG OUT` (`--sarif OUT`) out of the arguments, returning OUT.
def file_option(args, flag)
  index = args.index(flag)
  return nil unless index

  out = args[index + 1] || abort("#{flag} needs a file to write")
  args.slice!(index, 2)
  out
end

# The SARIF log, with results that have no line in the app's code pointing
# at the mapping file, relative to the app root.
def write_sarif(out, reports, file)
  File.write(out, Hallmark::Sarif.new(reports, fallback: sarif_fallback(file)).to_json)
end

def sarif_fallback(file)
  root = File.expand_path(Hallmark.configuration.root)
  path = File.expand_path(file.to_s)
  path.start_with?("#{root}/") ? path.delete_prefix("#{root}/") : file.to_s
end

# What CI knows, for `hallmark watch`: the run's stamps and each check's
# digest and verdict.
def write_baseline(out, reports, files)
  config = Hallmark.configuration
  run = Hallmark::StampSet.run_of(config.stamps, run: config.run) if reports.any? { |report| report.analysis.inference }
  Hallmark::Baseline.build(reports, mapping_digest: Hallmark::Baseline.digest_files(files), run: run).write(out)
end

# `hallmark watch`: parses its options, loads the mapping (never the app)
# and the baseline, and runs until stopped, or once.
def watch(args)
  options = watch_options(args)
  abort USAGE unless args.size == 1 && options[:baseline]
  file = args.fetch(0)
  mapping = mapping_from(file)
  watch = Hallmark::Watch.new(
    mapping: mapping, baseline: Hallmark::Baseline.load(options.fetch(:baseline)), source: watch_source(options),
    solver: watch_solver(options[:solver]), mapping_digest: Hallmark::Baseline.digest_files([file]),
    extractor: Hallmark::Extractor.load(mapping), json: options.fetch(:json), sarif: options[:sarif],
    sarif_fallback: sarif_fallback(file)
  )
  watch.run(once: options.fetch(:once), interval: options.fetch(:interval))
end

def watch_options(args)
  options = { interval: 2.0, json: false, once: false, from_start: false, all_runs: false }
  parser = OptionParser.new do |opts|
    %w[baseline stamps run redis stream sarif solver].each do |name|
      opts.on("--#{name} VALUE") { |value| options[name.to_sym] = value }
    end
    opts.on("--interval SECONDS", Float) { |value| options[:interval] = value }
    %w[json once from-start all-runs].each do |name|
      opts.on("--#{name}") { options[name.tr("-", "_").to_sym] = true }
    end
  end
  parser.parse!(args)
  options
rescue OptionParser::ParseError => e
  abort "hallmark watch: #{e.message}\n\n#{USAGE}"
end

# Files of one run under --stamps, or a Redis stream with --redis.
def watch_source(options)
  config = Hallmark.configuration
  run = options[:run] || config.run
  return Hallmark::Watch::FileTail.new(options[:stamps] || config.stamps, run: run) unless options[:redis]

  Hallmark::Watch::RedisTail.new(
    Hallmark::Watch::RedisTail.connect(options.fetch(:redis)),
    stream: options[:stream] || Hallmark::Sinks::RedisStream::DEFAULT_STREAM, run: run,
    all_runs: options.fetch(:all_runs), from_start: options.fetch(:from_start),
    block: (Integer(options.fetch(:interval) * 1000) unless options.fetch(:once))
  )
end

# The sidecar, warm for the life of the watch, unless --solver,
# HALLMARK_SOLVER or `c.solver` picks a backend; the CLI when it is not built.
def watch_solver(name)
  config = Hallmark.configuration
  config.solver = name if name
  return Hallmark::Solver.build(config) if config.solver_chosen?

  sidecar = Hallmark::Solver::Sidecar.new(config)
  return sidecar if sidecar.available?

  warn "hallmark watch: the solver sidecar is not built (run `hallmark install-sidecar`); " \
       "using the CLI, one JVM start per batch"
  Hallmark::Solver::CLI.new(config)
end

# The app a mapping file belongs to: the parent of its config/ directory
# (config/hallmark.rb), else the file's own directory. HALLMARK_ROOT wins.
def use_root(file)
  return if ENV.key?("HALLMARK_ROOT")

  dir = File.dirname(File.expand_path(file))
  Hallmark.configuration.root = File.basename(dir) == "config" ? File.dirname(dir) : dir
end

# Each rule the extractor reads under the app root, with its guard; the
# bounds when calls in it could not be read (docs/adr/0003).
def print_extracted(files)
  abort USAGE unless files.size == 1
  mapping = mapping_from(files.fetch(0))
  root = Hallmark.configuration.root
  extractor = Hallmark::Extractor.load(mapping, root)
  abort "No policy code under #{root} (looked in #{Hallmark::Extractor::DIRS.join(", ")})" unless extractor

  extractor.rules.each { |rule| puts extracted_lines(rule) }
  extractor.lists.each { |list| puts extracted_lines(list, "list ") }
  serializers = extractor.serializers
  puts serializer_lines(extractor, serializers) if serializers
  role_reads = extractor.role_reads
  puts role_read_lines(role_reads) if role_reads
end

# What the revocation lint read (phase 3 step 9): each start point and the
# methods it walked, each cache found and what clears it, and the calls it
# could not follow.
def role_read_lines(role_reads)
  lines = ["", "Role reads:"]
  role_reads.starts.each do |start|
    walked = start.walked.empty? ? "no method walked" : start.walked.join(", ")
    lines << "#{start.label}: #{walked}"
  end
  lines << "Caches:" if role_reads.caches.any?
  role_reads.caches.each { |cache| lines.push("  #{cache}", "    reached from #{cache.walked}") }
  lines << "Not followed:" if role_reads.unread.any?
  lines.concat(role_reads.unread.map { |unread| "  #{unread}" })
end

# The REST serializers read under the app root (phase 3 step 8): each one's
# resource and the fields with a policy, a restriction or a condition
# (options left as written), then each entry point's renderings.
def serializer_lines(extractor, serializers)
  mapping = Hallmark.analyses.last&.mapping || Hallmark.configuration.mapping
  lines = ["", "Serializers:"]
  serializers.serializers.each do |name|
    resource = serializers.resource_of(name)
    lines << "#{name} (#{serializers.dialect(name)}; #{resource ? "on #{resource}" : "no mapped resource"})"
    serializers.fields(name, resource).each { |field| lines.concat(serializer_field_lines(field, resource, mapping)) }
  end
  lines.concat(rendering_lines(extractor))
end

def serializer_field_lines(field, resource, mapping)
  return ["  #{field.name}: a #{field.resource} record (#{field.location})"] if field.nested?

  narrowed = field_narrowing(field, resource, mapping)
  condition = field.condition
  return [] if condition.kind == :none && narrowed.empty?

  key = field.key == field.name ? "" : " as #{field.key}"
  head = "  #{field.name}#{key} (#{field.location})#{narrowed}"
  return [head] if condition.kind == :none

  [head, *condition_lines(condition)]
end

# The field's policy and the restrictions naming it, for the head line.
def field_narrowing(field, resource, mapping)
  return "" unless resource && mapping

  policy = mapping.field_policy_for(resource, field.name)
  parts = [("field policy: #{policy.guard}" if policy)]
  parts += restricting(mapping, resource, field.name).map { |each| "restricted: #{each.name.inspect}" }
  parts.compact.empty? ? "" : " #{parts.compact.join("; ")}"
end

def restricting(mapping, resource, field)
  mapping.restrictions.values.select do |restriction|
    restriction.denials.any? { |denial| denial.resource == resource && (denial.fields || []).include?(field) }
  end
end

def condition_lines(condition)
  return ["    if #{condition}"] unless condition.opaque?

  ["    lower: #{condition.lower}", "    upper: #{condition.upper}",
   *condition.opaque_leaves.map do |leaf|
     "    not read: `#{leaf.operands[0]}`#{" (#{leaf.operands[1]})" if leaf.operands[1]}"
   end]
end

def rendering_lines(extractor)
  rendered = rendered_entry_points(extractor).reject { |_, renderings| renderings.empty? }
  return [] if rendered.empty?

  ["", "Renderings:"] + rendered.flat_map do |name, renderings|
    [name, *renderings.map { |rendering| "  #{rendering_text(extractor, rendering)}" }]
  end
end

# Rails entry points from config/routes.rb, then Grape endpoints.
def rendered_entry_points(extractor)
  rails = extractor.routes.map(&:entry_point).uniq.sort.filter_map do |name|
    read = extractor.controllers.fetch(name)
    read && [name, read.renderings]
  end
  grape = extractor.grape&.endpoints || []
  rails + grape.sort_by(&:name).map { |endpoint| [endpoint.name, endpoint.renderings] }
end

def rendering_text(extractor, rendering)
  serializer = extractor.serializers&.resolve(rendering) || rendering.unknown || rendering.serializer || "unknown"
  "#{rendering.text} with #{serializer} (#{rendering.location}; #{rendered_record(rendering)})"
end

def rendered_record(rendering)
  authorization = rendering.authorization || rendering.candidates.first
  return "authorized by #{authorization.policy || "?"}##{authorization.rule}" if authorization

  rendering.collection ? "a list" : "not authorized"
end

def extracted_lines(rule, kind = "")
  checked = rule.resource ? "on #{rule.resource}" : "no mapped resource"
  head = "#{kind}#{rule.key} (#{rule.location}; #{checked})"
  return [head, "  #{rule.guard}"] if rule.exact?

  [head, "  lower: #{rule.lower}", "  upper: #{rule.upper}",
   *rule.opaque_leaves.map { |leaf| "  not read: `#{leaf.operands[0]}` (#{leaf.operands[1]})" }]
end

# Each rule checked on its own (Hallmark::RuleCheck), then the hazards the
# DeclarativePolicy reader found.
def check_rules(args)
  file, *policies = args
  abort USAGE unless file
  mapping = mapping_from(file)
  extractor = Hallmark::Extractor.load(mapping)
  checker = Hallmark::RuleCheck.new(mapping, stamps_if_any, extractor: extractor)
  policies = policies_read(extractor) if policies.empty?
  results = policies.flat_map { |policy| checker.check(policy) }
  results.each { |result| puts result.lines }
  lints = extractor ? extractor.lints : []
  lints.each { |lint| puts "FAIL  #{lint} (policy-DSL hazard)" }
  puts "", rules_summary(results, lints)
  rules_exit(results, lints)
end

# The mapping a file declares, with the app root set from where it is.
def mapping_from(file)
  use_root(file)
  load_file(file)
  Hallmark.analyses.last&.mapping || Hallmark.configuration.mapping || abort("No mapping found in #{file}")
end

# Policies with a rule read from code on a mapped resource.
def policies_read(extractor)
  return [] unless extractor

  (extractor.rules + extractor.lists).select(&:resource).map(&:policy).uniq
end

def stamps_if_any
  dir = Hallmark.configuration.stamps
  Hallmark::StampSet.files(dir).any? ? Hallmark::StampSet.load(dir) : Hallmark::StampSet.new
end

def rules_summary(results, lints)
  counts = results.group_by(&:verdict).transform_values(&:size)
  parts = ["#{counts.fetch(:counterexample, 0)} counterexamples", "#{counts.fetch(:none, 0)} with none within scope"]
  parts << "#{counts.fetch(:unknown)} unknown" if counts.key?(:unknown)
  parts << "#{counts.fetch(:not_observed)} not observed" if counts.key?(:not_observed)
  parts << "#{lints.size} policy-DSL hazards" if lints.any?
  "#{results.size} rules: #{parts.join(", ")}."
end

def rules_exit(results, lints)
  return 1 if lints.any? || results.any?(&:counterexample?)

  results.any? { |result| result.verdict == :unknown } ? 2 : 0
end

# The CLI does not boot the app, so a mapping that names an app class by
# constant (`resource Link`, fine under the Railtie) cannot load here.
def load_file(file)
  load File.expand_path(file)
rescue NameError => e
  raise if e.is_a?(NoMethodError) || !e.message.start_with?("uninitialized constant")

  raise Hallmark::ConfigurationError,
        "#{file} names the class #{e.name}, which the hallmark command cannot load: it runs outside the app. " \
        "Name classes in strings in a file the CLI reads (resource \"#{e.name}\")"
end

begin
  case ARGV.shift
  when "check"
    sarif = file_option(ARGV, "--sarif")
    baseline = file_option(ARGV, "--baseline")
    files = ARGV.dup
    reports = load_analyses(ARGV).map(&:run)
    puts reports.join("\n\n")
    write_sarif(sarif, reports, files.first) if sarif
    write_baseline(baseline, reports, files) if baseline
    exit(Hallmark::Report.exit_code(reports))
  when "watch"
    exit(watch(ARGV))
  when "model"
    load_analyses(ARGV).each { |analysis| puts Hallmark::ModelBuilder.new(analysis).source }
  when "extract"
    print_extracted(ARGV)
  when "rules"
    exit(check_rules(ARGV))
  when "install-alloy"
    puts Hallmark::AlloyInstaller.new.install
  when "install-sidecar"
    Hallmark::AlloyInstaller.new.install
    puts Hallmark::SidecarInstaller.new.install
  when "version", "--version", "-v"
    puts "hallmark #{Hallmark::VERSION} (Alloy #{Hallmark::ALLOY_VERSION})"
  else
    puts USAGE
    exit 2
  end
rescue Hallmark::Error => e
  warn "hallmark: #{e.message}"
  exit 2
end
